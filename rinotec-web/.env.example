# Copia como .env para pruebas locales (no lo subas a GitHub)
FOUNDRY_PROJECT_ENDPOINT=https://asistente-rinotec-resource.services.ai.azure.com/api/projects/asistente-rinotec
# Agente para clientes (conocimiento limitado) y para empleados (conocimiento completo)
FOUNDRY_AGENT_CLIENTES=asistente-rinotec-clientes
FOUNDRY_AGENT_CLIENTES_VERSION=1
FOUNDRY_AGENT_EMPLEADOS=asistente-rinotec
FOUNDRY_AGENT_EMPLEADOS_VERSION=2
# Acceso de empleados con código (respaldo si no se usa Microsoft Entra ID)
EMPLOYEE_ACCESS_CODE=cambia-este-codigo
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
# Solo en tu computadora: true para probar el modo empleado sin iniciar sesión
DEV_EMPLEADO=false
# En Azure, con la autenticación de App Service activada: AUTH_ENTRA=true
AUTH_ENTRA=false
