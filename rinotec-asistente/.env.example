# Copia este archivo como .env para probar en tu computadora (no lo subas a GitHub)
# Punto de conexión DEL PROYECTO de Foundry (pantalla de inicio del proyecto en ai.azure.com)
FOUNDRY_PROJECT_ENDPOINT=https://<tu-recurso>.services.ai.azure.com/api/projects/<tu-proyecto>
# Nombre exacto del agente
FOUNDRY_AGENT_NAME=asistente-rinotec
# Versión activa del agente (se ve en Foundry junto al nombre; cada vez que guardas cambios sube la versión)
FOUNDRY_AGENT_VERSION=1
